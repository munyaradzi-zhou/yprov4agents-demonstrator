# Keep the build context small. The image needs pyproject.toml, uv.lock, README.md (named
# by the project metadata), and the three packages: yprov4agenticai/, runtime/, eval/.
#
# Note on *.ttl: the yp: vocabulary is a build artifact of the image once MC1 validates
# against it, so vocab/ is deliberately NOT excluded here.

# Version control and local environments
.git/
.github/
.venv/
venv/

# Run artifacts and frozen evidence: mounted at runtime, never baked in
out/
experiments/
_smoke/
emissions.csv
.codecarbon-tracker.pid

# Inputs are bind-mounted read-only by compose, not copied
data/

# Documentation and prose
docs/
paper/
figures/
*.md
!README.md
*.pdf
*.pptx
*.docx

# Tests and tooling caches
tests/
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Secrets: compose injects these as environment variables
.env
.env.*
