# Normalise line endings in the repository to LF.
#
# This matters more here than in most projects: the demonstrator computes SHA-256 content
# hashes over payloads it reads from disk (see yprov4agenticai/store.py) and asserts those
# hashes inside emitted provenance. If a checkout on Windows rewrote LF to CRLF, the same
# logical payload would hash differently on different platforms and the integrity claims in
# the provenance record would not reproduce.

* text=auto eol=lf

# Frozen experiment archives are evidence, and their manifests record a SHA-256 of each
# file's exact bytes. Line-ending normalisation would rewrite those bytes on checkout and
# every archive would fail verification on a fresh clone. Store them verbatim.
experiments/** -text

# Binary assets — never touch these.
*.png   binary
*.pdf   binary
*.pptx  binary
*.docx  binary

# Generated lockfile: keep verbatim, and keep it out of diff review noise.
uv.lock linguist-generated=true
