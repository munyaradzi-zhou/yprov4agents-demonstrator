# ── Run artifacts ────────────────────────────────────────────────────────────────
# Regenerate with `uv run python run_local.py`. Frozen snapshots that back a published
# result live under experiments/ and ARE versioned; this directory is scratch.
out/
_smoke/

# ── Secrets ──────────────────────────────────────────────────────────────────────
# Copy .env.example to .env and add your key there. Never commit .env.
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# ── Energy measurement side effects ──────────────────────────────────────────────
# CodeCarbon writes its emissions log and tracker lock into the working directory.
# Measured energy belongs with the run that produced it, under out/ or experiments/.
emissions.csv
.codecarbon-tracker.pid

# ── Tooling caches ───────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
