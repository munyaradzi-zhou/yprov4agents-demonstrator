# Copy to `.env` (same folder) — docker compose loads it automatically.
# The demonstrator runs END-TO-END WITHOUT a key: CAx falls back to a deterministic
# stub summary and CA3 reports its computed findings without LLM narration.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# CAX_VERDICT=model    # let the model decide CAx's verdict (needs a key); the code check is
#                      # still run and recorded beside it as yp:code_verdict
# LLM_REQUIRED=1       # fail instead of silently falling back to the computed path
#
# run_local.py reads this file itself: to force the keyless path while a key is set here,
# run with OPENAI_API_KEY= (empty), not with the variable unset.
